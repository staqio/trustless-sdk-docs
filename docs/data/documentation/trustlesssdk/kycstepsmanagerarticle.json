iewCell() }","","        switch fieldObject.type {","        case .boolean:","            let cell = tableView.dequeueReusableCell(withIdentifier: \"BooleanFieldCell\", for: indexPath) as! BooleanFieldTableViewCell","            return cell","        case .lov, .url:","            let cell = tableView.dequeueReusableCell(withIdentifier: \"SelectFieldCell\", for: indexPath) as! SelectFieldTableViewCell","            return cell","        case .text, .integer, .decimal:","            let cell = tableView.dequeueReusableCell(withIdentifier: \"TextFieldCell\", for: indexPath) as! TextFieldTableViewCell","            return cell","        case .date:","            let cell = tableView.dequeueReusableCell(withIdentifier: \"DateFieldCell\", for: indexPath) as! DateFieldTableViewCell","            return cell","        case .document:","            let cell = tableView.dequeueReusableCell(withIdentifier: \"FileFieldCell\", for: indexPath) as! FileFieldTableViewCell","            return cell","        default:","            return UITableViewCell()","        }","    }","}",""]},{"inlineContent":[{"type":"text","text":"\/\/ TODO: add kyc scan section"}],"type":"paragraph"}]}],"kind":"article","variants":[{"paths":["\/documentation\/trustlesssdk\/kycstepsmanagerarticle"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK/KYCFieldType/date":{"title":"KYCFieldType.date","role":"symbol","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/KYCFieldType\/date","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"date","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A date field."}],"kind":"symbol","url":"\/documentation\/trustlesssdk\/kycfieldtype\/date"},"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK/KYCStepsManager/getJson()":{"abstract":[{"type":"text","text":"Retrieves the JSON-compatible value of the all steps for submission."}],"titl