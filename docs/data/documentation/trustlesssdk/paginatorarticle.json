{"hierarchy":{"paths":[["doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK"]]},"abstract":[{"text":"Sending and handling paginated requests: Paginator helper.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/PaginatorArticle"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Paginator Usage","role":"article","modules":[{"name":"TrustlessSDK"}],"roleHeading":"Article"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Staq server APIs provides some listed data in paginated type. TrustlessSDK provide a way to handle paginated API request via ","type":"text"},{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":" object. It manages the retrieval of data in pages, tracking the current page number, total items, and handling the request status.","type":"text"}],"type":"paragraph"},{"text":"Gettin Started","type":"heading","level":2,"anchor":"Gettin-Started"},{"inlineContent":[{"text":"Paginator provides:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":", you can use it to fetch first page or to reset previous results;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":", you can use this method to fetch next pages,","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"to perform retrieval of data in pages.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"fetchNextPage(completion:)"},{"type":"text","text":" should be called after "},{"type":"codeVoice","code":"fetchFirstPage(completion:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"text":"To retrieve results Paginator provides ","type":"text"},{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/results","type":"reference","isActive":true},{"text":", this property includes all results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To handle result you can assign handlers to paginator:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":", to handle results;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":", to handle errors.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Also Paginator provides additional properties:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/pageNumber","type":"reference","isActive":true},{"text":", stores the current page number;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/totalPages","type":"reference","isActive":true},{"text":", stores the total number of pages;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/requestStatus","type":"reference","isActive":true},{"text":", stores the current status of the data request (","type":"text"},{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/RequestStatus","type":"reference","isActive":true},{"text":");","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/reachedLastPage","type":"reference","isActive":true},{"text":", indicates whether the last page has been reached;","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"To cancel outgoing request Paginator provides optional ","type":"text"},{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference","isActive":true},{"text":", that is asseable after first call of retrieval data methods.","type":"text"}],"type":"paragraph"},{"text":"Basic Example","type":"heading","level":2,"anchor":"Basic-Example"},{"syntax":"swift","code":["import UIKit","import TrustlessSDK","","class ViewController: UIViewController, UITableViewDataSource, UITableViewDelegate, UIScrollViewDelegate {","    let paginator = TrustlessSDK.cardsProvider.getCardsPaginator(pageSize: 10)","","    override func viewDidLoad() {","        super.viewDidLoad()","        _ = paginator.fetchFirstPage { _ in","            self.tableView.reloadData()","        }","    }","","    func insertElements(newItemsCount: Int) {","        let startIndex = paginator.results.count - newItemsCount","        let indexPaths = (startIndex ..< paginator.results.count).map { IndexPath(row: $0, section: 0) }","","        tableView.beginUpdates()","        tableView.insertRows(at: indexPaths, with: .automatic)","        tableView.endUpdates()","    }","","    \/\/ TableViewDelegate","","    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {","        return paginator.results.count","    }","","    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {","        return UITableViewCell()","    }","","    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {}","","    \/\/ ScrollViewDelegate","","    override func scrollViewDidScroll(_ scrollView: UIScrollView) {","        guard !paginator.reachedLastPage else { return }","","        let offsetY = scrollView.contentOffset.y","        let contentHeight = scrollView.contentSize.height","        let height = scrollView.frame.size.height","","        if offsetY > contentHeight - height * 1, !(paginator.requestStatus == .inProgress) {","            cancelCallback = paginator.fetchNextPage { result in","                self.endLoadingMoreItems()","                switch result {","                case .success(let data):","                    self.insertElements(newItemsCount: data.count)","                case .failure:","                    break","                }","            }","        }","    }","}"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustlesssdk\/paginatorarticle"]}],"seeAlsoSections":[{"generated":true,"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/IntegrationArticle","doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/RequestSendingArticle","doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/KYCStepsManagerArticle"]}],"references":{"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK/RequestSendingArticle":{"abstract":[{"text":"Sending requests to and receiving responses from Staq Server APIs: A detailed walkthrough.","type":"text"}],"title":"Request Sending","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/RequestSendingArticle","type":"topic","kind":"article","url":"\/documentation\/trustlesssdk\/requestsendingarticle","role":"article"},"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK/Paginator/pageNumber":{"abstract":[{"text":"The current page number that is being fetched or