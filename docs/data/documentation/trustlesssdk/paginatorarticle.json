{"hierarchy":{"paths":[["doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Staq server APIs provides some listed data in paginated type. TrustlessSDK provide a way to handle paginated API request via ","type":"text"},{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","isActive":true,"type":"reference"},{"type":"text","text":" object. It manages the retrieval of data in pages, tracking the current page number, total items, and handling the request status."}]},{"anchor":"Gettin-Started","type":"heading","level":2,"text":"Gettin Started"},{"inlineContent":[{"type":"text","text":"Paginator provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/fetchFirstPage(completion:)","type":"reference"},{"text":", you can use it to fetch first page or to reset previous results;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/fetchNextPage(completion:)","isActive":true,"type":"reference"},{"type":"text","text":", you can use this method to fetch next pages,"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"to perform retrieval of data in pages."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"fetchNextPage(completion:)"},{"type":"text","text":" should be called after "},{"code":"fetchFirstPage(completion:)","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"To retrieve results Paginator provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/results"},{"text":", this property includes all results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To handle result you can assign handlers to paginator:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/setResultsHandler(_:)","isActive":true,"type":"reference"},{"text":", to handle results;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/setFailureHandler(_:)"},{"text":", to handle errors.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Also Paginator provides additional properties:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/pageNumber","isActive":true,"type":"reference"},{"type":"text","text":", stores the current page number;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/totalPages"},{"type":"text","text":", stores the total number of pages;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/requestStatus"},{"type":"text","text":", stores the current status of the data request ("},{"type":"reference","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/RequestStatus","isActive":true},{"text":");","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator\/reachedLastPage","isActive":true,"type":"reference"},{"type":"text","text":", indicates whether the last page has been reached;"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To cancel outgoing request Paginator provides optional "},{"isActive":true,"identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/Paginator","type":"reference"},{"text":", that is asseable after first call of retrieval data methods.","type":"text"}]},{"text":"Basic Example","anchor":"Basic-Example","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["import UIKit","import TrustlessSDK","","class ViewController: UIViewController, UITableViewDataSource, UITableViewDelegate, UIScrollViewDelegate {","    let paginator = TrustlessSDK.cardsProvider.getCardsPaginator(pageSize: 10)","","    override func viewDidLoad() {","        super.viewDidLoad()","        _ = paginator.fetchFirstPage { _ in","            self.tableView.reloadData()","        }","    }","","    func insertElements(newItemsCount: Int) {","        let startIndex = paginator.results.count - newItemsCount","        let indexPaths = (startIndex ..< paginator.results.count).map { IndexPath(row: $0, section: 0) }","","        tableView.beginUpdates()","        tableView.insertRows(at: indexPaths, with: .automatic)","        tableView.endUpdates()","    }","","    \/\/ TableViewDelegate","","    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {","        return paginator.results.count","    }","","    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {","        return UITableViewCell()","    }","","    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {}","","    \/\/ ScrollViewDelegate","","    override func scrollViewDidScroll(_ scrollView: UIScrollView) {","        guard !paginator.reachedLastPage else { return }","","        let offsetY = scrollView.contentOffset.y","        let contentHeight = scrollView.contentSize.height","        let height = scrollView.frame.size.height","","        if offsetY > contentHeight - height * 1, !(paginator.requestStatus == .inProgress) {","            cancelCallback = paginator.fetchNextPage { result in","                self.endLoadingMoreItems()","                switch result {","                case .success(let data):","                    self.insertElements(newItemsCount: data.count)","                case .failure:","                    break","                }","            }","        }","    }","}"]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/IntegrationArticle","doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/RequestSendingArticle","doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/KYCStepsManagerArticle"],"title":"Articles","anchor":"Articles"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trustlesssdk\/paginatorarticle"]}],"metadata":{"role":"article","modules":[{"name":"TrustlessSDK"}],"roleHeading":"Article","title":"Paginator Usage"},"sections":[],"identifier":{"url":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK\/PaginatorArticle","interfaceLanguage":"swift"},"kind":"article","abstract":[{"text":"Sending and handling paginated requests: Paginator helper.","type":"text"}],"references":{"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK":{"role":"collection","url":"\/documentation\/trustlesssdk","identifier":"doc:\/\/com.staq.TrustlessSDK\/documentation\/TrustlessSDK","kind":"symbol","type":"topic","title":"TrustlessSDK","abstract":[]},"doc://com.staq.TrustlessSDK/documentation/TrustlessSDK/Paginator/setResultsHandler(_:)":{"abstract":[{"text":"Sets a handler to be called with the results of each successful fetch operation.","type":"text"}],"role":"symbol","tit